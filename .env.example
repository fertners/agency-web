NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3001
API_URL=http://127.0.0.1:3001
PUBLIC_API_URL=http://127.0.0.1:3001
AI_PROVIDER=local
# Required only when AI_PROVIDER=openai. Never commit a real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
ADMIN_API_TOKEN=
OPERATOR_API_TOKEN=
INTERNAL_API_TOKEN=
PREVIEW_URL=http://127.0.0.1:3002
PREVIEW_BASE_URL=http://127.0.0.1:3002
NEXT_PUBLIC_API_URL=http://127.0.0.1:3001
PUBLIC_DASHBOARD_URL=http://127.0.0.1:3000
ARTIFACTS_ROOT=artifacts

# Local PostgreSQL
POSTGRES_DB=ai_web_agency
POSTGRES_USER=agency
POSTGRES_PASSWORD=local_development_only
POSTGRES_PORT=5432
DATABASE_URL=postgresql://agency:local_development_only@localhost:5432/ai_web_agency

# Local Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Real prospect research (OpenStreetMap/Overpass by default)
BUSINESS_SEARCH_PROVIDER=overpass
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
BUSINESS_SEARCH_USER_AGENT=AIWebAgency/0.1 (contact: your-email@example.com)
